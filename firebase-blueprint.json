{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered FUHSI Connect student and admin accounts",
      "properties": {
        "id": { "type": "string" },
        "nickname": { "type": "string" },
        "realName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "matricNumber": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
